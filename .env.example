# AIBOS Framework Environment Variables
# Copy to .env.local for local development

# === Node Environment ===
NODE_ENV=development
DEBUG=aibos:*

# === GitHub Intelligence ===
GITHUB_TOKEN=ghp_xxxxx

# === Database (PostgreSQL) ===
DATABASE_URL=postgresql://user:password@localhost:5432/aibos_dev
DB_HOST=localhost
DB_PORT=5432
DB_USER=aibos_user
DB_PASSWORD=secure_password
DB_NAME=aibos_dev

# === Redis Cache ===
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# === API Configuration ===
API_PORT=3000
API_TIMEOUT_MS=5000
API_MAX_RETRIES=3
API_LOG_LEVEL=info

# === Authentication ===
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_EXPIRY=7d
SESSION_SECRET=your_session_secret_key

# === Security ===
ENCRYPTION_KEY=your_encryption_key_min_32_chars
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# === Monitoring & Logging ===
LOG_LEVEL=info
SENTRY_DSN=https://key@sentry.io/project-id
DATADOG_API_KEY=dd_xxxxx

# === External Services ===
OPENAI_API_KEY=sk-xxxxx
GROQ_API_KEY=gsk_xxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxx

# === Email (SMTP) ===
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend_user
SMTP_PASSWORD=resend_password
SMTP_FROM=noreply@aibos.io

# === Third-party Integrations ===
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# === Development Tools ===
ENABLE_SWAGGER=true
ENABLE_PLAYGROUND=true
VERBOSE_LOGS=false

# === Testing ===
TEST_DATABASE_URL=postgresql://test:test@localhost:5432/aibos_test
TEST_REDIS_URL=redis://localhost:6380
