#!/bin/sh

# Pre-commit hook for AIBOS Framework
# Runs linting, formatting, and tests before allowing commit

echo "🔍 Running pre-commit checks..."

# Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|ts)$')

if [ -z "$STAGED_FILES" ]; then
  echo "✅ No JavaScript/TypeScript files to check"
  exit 0
fi

echo "📝 Checking staged files..."

# Lint
echo "🔎 Linting..."
npm run lint
if [ $? -ne 0 ]; then
  echo "❌ Linting failed"
  exit 1
fi

# Format (auto-fix)
echo "✨ Formatting..."
npm run lint:fix
npm run format

# Re-stage formatted files
git add $STAGED_FILES

# Run tests for changed modules
echo "🧪 Running tests..."
npm run test -- --testPathPattern="$(echo $STAGED_FILES | sed 's/ /|/g')"
if [ $? -ne 0 ]; then
  echo "⚠️  Tests failed (non-blocking)"
fi

echo "✅ Pre-commit checks passed!"
exit 0
